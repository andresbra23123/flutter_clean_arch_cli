// ─────────────────────────────────────────────────────────────
// AppUtils
// General utility functions used across the app.
// ─────────────────────────────────────────────────────────────

import 'package:{{package}}/core/validation/validation.dart';
import 'package:flutter/material.dart';
import 'package:intl/intl.dart';

/// Helpers for common UI actions, formatting and validation.
class AppUtils {
  AppUtils._();

  /// Shows a floating [SnackBar] with [message] for 3 seconds.
  ///
  /// It is red when [isError] is `true` and green otherwise.
  static void showSnackBar(
    BuildContext context,
    String message, {
    bool isError = false,
  }) {
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(message),
        backgroundColor: isError ? Colors.red : Colors.green,
        behavior: SnackBarBehavior.floating,
        duration: const Duration(seconds: 3),
      ),
    );
  }

  /// Shows a full-screen loading indicator that the user cannot dismiss.
  ///
  /// Close it with [dismissDialog].
  static Future<void> showLoadingDialog(BuildContext context) async {
    await showDialog(
      context: context,
      barrierDismissible: false,
      builder: (_) => const Center(child: CircularProgressIndicator()),
    );
  }

  /// Closes the top-most route (e.g. the dialog from [showLoadingDialog]),
  /// if there is one.
  static void dismissDialog(BuildContext context) {
    if (Navigator.of(context).canPop()) {
      Navigator.of(context).pop();
    }
  }

  /// Formats [date] as a short date in [locale] (the current `Intl` locale
  /// when `null`), e.g. `8/10/2026` in Spanish or `10/8/2026` in English.
  ///
  /// Pass `Localizations.localeOf(context).toString()` to follow the app.
  static String formatDate(DateTime date, {String? locale}) {
    return DateFormat.yMd(locale).format(date);
  }

  /// Whether [email] has a valid email address format.
  static bool isValidEmail(String email) {
    return ValidationRules.isValidEmail(email);
  }

  /// Whether [value] is `null`, empty or contains only whitespace.
  static bool isNullOrEmpty(String? value) {
    return value == null || ValidationRules.isBlank(value);
  }

  // TODO({{todoTag}}): Add more utility methods specific to the app.
}
