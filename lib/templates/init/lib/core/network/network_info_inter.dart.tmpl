// ─────────────────────────────────────────────────────────────
// NetworkInfoInter (contract)
// Tells whether the device has an active internet connection.
// Repositories depend on this contract to decide between remote and
// local data, so it can be replaced by a mock in tests.
// ─────────────────────────────────────────────────────────────

/// Network connectivity contract.
abstract interface class NetworkInfoInter {
  /// Whether the device can currently reach the internet.
  Future<bool> get isConnected;

  /// Emits `true` when the connection comes back and `false` when it is
  /// lost; repeated values are skipped.
  Stream<bool> get onStatusChange;
}
