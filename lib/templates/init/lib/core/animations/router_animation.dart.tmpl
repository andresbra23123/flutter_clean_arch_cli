/// Page transitions used by the routes in `AppRouter`.
library;

import 'package:flutter/material.dart';
import 'package:go_router/go_router.dart';

/// Transition played when navigating to a page.
enum RouterAnimationType {
  /// The page fades in.
  fade,

  /// The page slides in from the right.
  slide,

  /// The page grows from 80% to its full size.
  scale,
}

/// Wraps [page] in a [CustomTransitionPage] that plays [animationType]
/// over 600 ms with an ease-out curve.
///
/// Use it in the `pageBuilder` of a `GoRoute`.
CustomTransitionPage<void> routerAnimation({
  required Widget page,
  required RouterAnimationType animationType,
}) {
  return CustomTransitionPage(
    child: page,
    transitionDuration: const Duration(milliseconds: 600),
    transitionsBuilder: (context, animation, secondaryAnimation, child) {
      final curved = CurvedAnimation(parent: animation, curve: Curves.easeOut);

      switch (animationType) {
        case RouterAnimationType.fade:
          return FadeTransition(
            opacity: Tween<double>(begin: 0, end: 1).animate(curved),
            child: child,
          );
        case RouterAnimationType.slide:
          return SlideTransition(
            position: Tween<Offset>(
              begin: const Offset(1, 0), // Enters from the right
              end: Offset.zero,
            ).animate(curved),
            child: child,
          );
        case RouterAnimationType.scale:
          return ScaleTransition(
            scale: Tween<double>(begin: 0.8, end: 1).animate(curved),
            child: child,
          );
      }
    },
  );
}
