// ─────────────────────────────────────────────────────────────
// UseCaseInter / UseCaseInterStream / UseCaseInterSync (contracts)
// Every use case in the domain layer implements one of them:
// UseCaseInter for a single result (Future), UseCaseInterStream for
// results over time (Stream), UseCaseInterSync for an immediate value
// that cannot fail. The first two return Either<Failure, T> (dartz)
// instead of throwing, so errors are part of the return type.
// ─────────────────────────────────────────────────────────────

import 'package:{{package}}/core/errors/errors.dart';
import 'package:{{package}}/core/type_defs/type_defs.dart';
import 'package:equatable/equatable.dart';

/// Contract for a use case: a single business operation.
///
/// [ReturnType] is the value returned on success and [ParamsType] is the
/// input the operation needs. Use [NoParams] when it needs none.
///
/// Because it defines `call`, a use case can be invoked like a function:
/// `await getSongs(const NoParams())`.
abstract interface class UseCaseInter<ReturnType, ParamsType> {
  /// Runs the use case with [params].
  ///
  /// Returns a [Failure] on the left side or the result on the right side.
  FutureEither<ReturnType> call(ParamsType params);
}

/// Contract for a use case that emits results over time, e.g. watching
/// the signed-in user or a list that updates live.
///
/// Each event is a [Failure] on the left side or a value on the right
/// side; an error does not end the stream. Data sources usually expose a
/// plain `Stream` and the repository converts it with `toEither`.
///
/// Invoke it like a function and listen to the result:
/// `watchSongs(const NoParams()).listen(...)`.
abstract interface class UseCaseInterStream<ReturnType, ParamsType> {
  /// Starts the use case with [params].
  StreamEither<ReturnType> call(ParamsType params);
}

/// Contract for a use case that answers right away and cannot fail, e.g.
/// reading a value the app already holds in memory.
///
/// It returns the value directly instead of an Either, so it can be used
/// where a `Future` is not possible (such as the initial state of a BLoC).
abstract interface class UseCaseInterSync<ReturnType, ParamsType> {
  /// Runs the use case with [params].
  ReturnType call(ParamsType params);
}

/// Parameter type for use cases that do not need any input.
class NoParams extends Equatable {
  /// Creates the (empty) parameters.
  const NoParams();

  @override
  List<Object> get props => [];
}
