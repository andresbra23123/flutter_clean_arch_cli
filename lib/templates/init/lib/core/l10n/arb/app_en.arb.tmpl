{
    "@@locale": "en",
    "homeTitle": "{{appTitle}}",
    "@homeTitle": {
        "description": "Title shown in the AppBar of the home page"
    },
    "homeWelcome": "Welcome to {{appTitle}}",
    "@homeWelcome": {
        "description": "Welcome message shown on the home page"
    },
    "notFoundTitle": "Page not found",
    "@notFoundTitle": {
        "description": "Title shown in the AppBar when a route does not exist"
    },
    "notFoundMessage": "The page you are looking for does not exist.",
    "@notFoundMessage": {
        "description": "Message shown when a route does not exist"
    },
    "notFoundBackHome": "Back to home",
    "@notFoundBackHome": {
        "description": "Button that returns to the home page from the not found page"
    },
    "validationNameRequired": "Enter your name",
    "@validationNameRequired": {
        "description": "Validation error: empty name"
    },
    "validationEmailRequired": "Enter your email",
    "@validationEmailRequired": {
        "description": "Validation error: empty email"
    },
    "validationEmailInvalid": "Enter a valid email",
    "@validationEmailInvalid": {
        "description": "Validation error: badly formatted email"
    },
    "validationPasswordRequired": "Enter your password",
    "@validationPasswordRequired": {
        "description": "Validation error: empty password"
    },
    "validationPasswordTooShort": "Use at least {min} characters",
    "@validationPasswordTooShort": {
        "description": "Validation error: password too short",
        "placeholders": {
            "min": {
                "type": "int"
            }
        }
    },
    "validationPasswordsDontMatch": "Passwords don't match",
    "@validationPasswordsDontMatch": {
        "description": "Validation error: password and confirmation differ"
    },
    "validationConfirmPasswordRequired": "Confirm your password",
    "@validationConfirmPasswordRequired": {
        "description": "Validation error: empty password confirmation"
    }
}
