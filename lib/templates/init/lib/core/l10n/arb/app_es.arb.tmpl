{
    "@@locale": "es",
    "homeTitle": "{{appTitle}}",
    "@homeTitle": {
        "description": "Título mostrado en la AppBar de la página de inicio"
    },
    "homeWelcome": "Bienvenido a {{appTitle}}",
    "@homeWelcome": {
        "description": "Mensaje de bienvenida de la página de inicio"
    },
    "notFoundTitle": "Página no encontrada",
    "@notFoundTitle": {
        "description": "Título mostrado en la AppBar cuando una ruta no existe"
    },
    "notFoundMessage": "La página que buscas no existe.",
    "@notFoundMessage": {
        "description": "Mensaje mostrado cuando una ruta no existe"
    },
    "notFoundBackHome": "Volver al inicio",
    "@notFoundBackHome": {
        "description": "Botón que regresa a la página de inicio desde la página no encontrada"
    },
    "validationNameRequired": "Escribe tu nombre",
    "@validationNameRequired": {
        "description": "Error de validación: nombre vacío"
    },
    "validationEmailRequired": "Escribe tu correo",
    "@validationEmailRequired": {
        "description": "Error de validación: correo vacío"
    },
    "validationEmailInvalid": "Escribe un correo válido",
    "@validationEmailInvalid": {
        "description": "Error de validación: correo con formato inválido"
    },
    "validationPasswordRequired": "Escribe tu contraseña",
    "@validationPasswordRequired": {
        "description": "Error de validación: contraseña vacía"
    },
    "validationPasswordTooShort": "Usa al menos {min} caracteres",
    "@validationPasswordTooShort": {
        "description": "Error de validación: contraseña demasiado corta",
        "placeholders": {
            "min": {
                "type": "int"
            }
        }
    },
    "validationPasswordsDontMatch": "Las contraseñas no coinciden",
    "@validationPasswordsDontMatch": {
        "description": "Error de validación: la contraseña y su confirmación no coinciden"
    },
    "validationConfirmPasswordRequired": "Confirma tu contraseña",
    "@validationConfirmPasswordRequired": {
        "description": "Error de validación: confirmación de contraseña vacía"
    }
}
