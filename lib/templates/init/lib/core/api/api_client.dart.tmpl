// ─────────────────────────────────────────────────────────────
// ApiClient
// Configures the Dio HTTP client shared by every remote data source.
// The base URL and timeouts come from AppConstants; the endpoint paths
// live in each feature (`<feature>_endpoints.dart`).
// ─────────────────────────────────────────────────────────────

import 'package:{{package}}/core/api/api.dart';
import 'package:{{package}}/core/constants/constants.dart';
import 'package:dio/dio.dart';

/// HTTP client used by the remote data sources to call the API.
///
/// Dio throws a [DioException] for connection errors, timeouts and non-2xx
/// responses: callers catch it and throw `toAppException()` (see
/// `DioExceptionX`).
class ApiClient {
  /// The underlying [Dio], for requests the helpers do not cover. Tests can
  /// add an interceptor through it.
  final Dio dio = Dio(
    BaseOptions(
      // TODO({{todoTag}}): Set the real API base URL in AppConstants.baseUrl.
      baseUrl: AppConstants.baseUrl,
      connectTimeout: const Duration(seconds: AppConstants.connectTimeout),
      receiveTimeout: const Duration(seconds: AppConstants.receiveTimeout),
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
      },
    ),
  )..interceptors.add(ApiInterceptor());

  /// Sends a GET request to [path] with optional [queryParameters].
  Future<Response> get(String path, {Map<String, dynamic>? queryParameters}) =>
      dio.get(path, queryParameters: queryParameters);

  /// Sends a POST request to [path] with [data] as the body.
  ///
  /// With [files] the body is a multipart form, and [data] must then be a
  /// `Map<String, dynamic>` with the other fields.
  Future<Response> post(
    String path, {
    Object? data,
    List<ApiFile> files = const [],
  }) async => dio.post(path, data: await _bodyOf(data, files));

  /// Sends a PUT request to [path] with [data] as the body.
  ///
  /// With [files] the body is a multipart form, as in [post].
  Future<Response> put(
    String path, {
    Object? data,
    List<ApiFile> files = const [],
  }) async => dio.put(path, data: await _bodyOf(data, files));

  /// Sends a DELETE request to [path] with optional [queryParameters].
  Future<Response> delete(
    String path, {
    Map<String, dynamic>? queryParameters,
  }) => dio.delete(path, queryParameters: queryParameters);

  /// [data] as sent: a multipart form when there are [files], else as is.
  static Future<Object?> _bodyOf(Object? data, List<ApiFile> files) async {
    if (files.isEmpty) return data;
    final form = FormData.fromMap(data as Map<String, dynamic>? ?? const {});
    for (final file in files) {
      form.files.add(
        MapEntry(file.field, await MultipartFile.fromFile(file.path)),
      );
    }
    return form;
  }
}

/// A file on the device uploaded with [ApiClient.post] or [ApiClient.put].
class ApiFile {
  /// Creates the file.
  const ApiFile({required this.field, required this.path});

  /// Form field that carries it, e.g. `images[]`.
  final String field;

  /// Absolute path of the file on the device.
  final String path;
}
