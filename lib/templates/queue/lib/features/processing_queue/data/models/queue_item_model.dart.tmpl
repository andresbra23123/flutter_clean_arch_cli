// ─────────────────────────────────────────────────────────────
// QueueItemModel
// QueueItemEntity plus its SQLite row mapping, so the data layer can
// read and write it while the domain only sees the entity.
// ─────────────────────────────────────────────────────────────

import 'dart:convert';

import 'package:{{package}}/core/queue_sync/queue_sync.dart';
import 'package:{{package}}/features/processing_queue/data/datasources/local/database/queue_table.dart';
import 'package:{{package}}/features/processing_queue/domain/domain.dart';

/// [QueueItemEntity] with conversion to and from a [QueueColumns] row.
class QueueItemModel extends QueueItemEntity {
  /// Creates the queue item model.
  const QueueItemModel({
    required super.id,
    required super.operation,
    required super.payload,
    required super.status,
    required super.createdAt,
    required super.updatedAt,
    super.priority,
    super.attempts,
    super.lastError,
    super.processedAt,
  });

  /// Creates a model from a [QueueColumns] row.
  factory QueueItemModel.fromRow(Map<String, Object?> row) {
    final processedAt = row[QueueColumns.processedAt] as int?;
    return QueueItemModel(
      id: row[QueueColumns.id]! as String,
      operation: row[QueueColumns.operation]! as String,
      payload: jsonDecode(
        row[QueueColumns.payload]! as String,
      ) as Map<String, dynamic>,
      status: queueSyncStatusFromDb(row[QueueColumns.status]! as String),
      priority: queuePriorityFromDb(row[QueueColumns.priority]! as int),
      attempts: row[QueueColumns.attempts]! as int,
      lastError: row[QueueColumns.lastError] as String?,
      createdAt: DateTime.fromMillisecondsSinceEpoch(
        row[QueueColumns.createdAt]! as int,
      ),
      updatedAt: DateTime.fromMillisecondsSinceEpoch(
        row[QueueColumns.updatedAt]! as int,
      ),
      processedAt: processedAt == null
          ? null
          : DateTime.fromMillisecondsSinceEpoch(processedAt),
    );
  }

  /// Converts this model into a [QueueColumns] row.
  Map<String, Object?> toRow() {
    return {
      QueueColumns.id: id,
      QueueColumns.operation: operation,
      QueueColumns.payload: jsonEncode(payload),
      QueueColumns.status: status.toDb(),
      QueueColumns.priority: priority.toDb(),
      QueueColumns.attempts: attempts,
      QueueColumns.lastError: lastError,
      QueueColumns.createdAt: createdAt.millisecondsSinceEpoch,
      QueueColumns.updatedAt: updatedAt.millisecondsSinceEpoch,
      QueueColumns.processedAt: processedAt?.millisecondsSinceEpoch,
    };
  }
}
