// ─────────────────────────────────────────────────────────────
// RetryFailedItemsUseCase
// Sends again every queue item that ended in error.
// Called from a BLoC; the UI never calls the repository directly.
// ─────────────────────────────────────────────────────────────

import 'package:{{package}}/core/type_defs/type_defs.dart';
import 'package:{{package}}/core/usecases/usecases.dart';
import 'package:{{package}}/features/processing_queue/domain/domain.dart';

/// Moves every failed item back to the queue through the
/// [ProcessingQueueRepositoryInter].
class RetryFailedItemsUseCaseImpl implements UseCaseInter<int, NoParams> {
  /// Creates the use case with the [repository] it uses.
  RetryFailedItemsUseCaseImpl({required this.repository});

  /// Source of the processing_queue data.
  final ProcessingQueueRepositoryInter repository;

  /// Returns how many items were moved, or a `Failure` if the queue could
  /// not be updated.
  @override
  FutureEither<int> call(NoParams params) {
    return repository.retryFailedItems();
  }
}
