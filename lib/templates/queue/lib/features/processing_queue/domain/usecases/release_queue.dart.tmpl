// ─────────────────────────────────────────────────────────────
// ReleaseQueueUseCase
// Sends the pending items of the processing queue to the API.
// Called from a BLoC; the UI never calls the repository directly.
// ─────────────────────────────────────────────────────────────

import 'package:{{package}}/core/type_defs/type_defs.dart';
import 'package:{{package}}/core/usecases/usecases.dart';
import 'package:{{package}}/features/processing_queue/domain/domain.dart';

/// Releases the queue through the [ProcessingQueueRepositoryInter].
class ReleaseQueueUseCaseImpl
    implements UseCaseInter<QueueReleaseResult, NoParams> {
  /// Creates the use case with the [repository] it uses.
  ReleaseQueueUseCaseImpl({required this.repository});

  /// Source of the processing_queue data.
  final ProcessingQueueRepositoryInter repository;

  /// Returns the summary of the release, or a `Failure` if it could not
  /// run.
  @override
  FutureEither<QueueReleaseResult> call(NoParams params) {
    return repository.releaseQueue();
  }
}
