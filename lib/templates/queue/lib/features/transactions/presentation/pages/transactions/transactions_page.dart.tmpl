// ─────────────────────────────────────────────────────────────
// TransactionsPage
// Lists the transactions with their sync status and records new ones
// (route start/end or the result of an order). Every new transaction
// goes to the processing queue.
// TransactionsPage provides the BLoC; TransactionsView builds the UI.
// ─────────────────────────────────────────────────────────────

import 'package:flutter/material.dart';
import 'package:flutter_bloc/flutter_bloc.dart';
import 'package:go_router/go_router.dart';
import 'package:{{package}}/core/di/di.dart';
import 'package:{{package}}/core/l10n/l10n.dart';
import 'package:{{package}}/core/router/router.dart';
import 'package:{{package}}/core/utils/utils.dart';
import 'package:{{package}}/features/transactions/presentation/presentation.dart';

/// Entry point of the transactions screen.
class TransactionsPage extends StatelessWidget {
  /// Creates the transactions page.
  const TransactionsPage({super.key});

  /// Route path of this page, registered in AppRouter.
  static const String routeName = AppRoutes.transactions;

  @override
  Widget build(BuildContext context) {
    return BlocProvider(
      create: (_) =>
          getIt<TransactionsBloc>()
            ..add(const TransactionsSubscriptionRequested()),
      child: const TransactionsView(),
    );
  }
}

/// UI of the transactions screen. Reads the [TransactionsBloc] provided
/// by [TransactionsPage].
class TransactionsView extends StatelessWidget {
  /// Creates the transactions view.
  const TransactionsView({super.key});

  Future<void> _create(BuildContext context) async {
    final bloc = context.read<TransactionsBloc>();
    final event = await TransactionFormDialog.show(context);
    if (event != null) bloc.add(event);
  }

  @override
  Widget build(BuildContext context) {
    final l10n = context.l10n;
    return Scaffold(
      appBar: AppBar(
        title: Text(l10n.transactionsTitle),
        actions: [
          IconButton(
            tooltip: l10n.queueTitle,
            icon: const Icon(Icons.queue),
            onPressed: () => context.pushNamed(AppRoutes.processingQueueName),
          ),
        ],
      ),
      body: BlocConsumer<TransactionsBloc, TransactionsState>(
        listenWhen: (previous, current) =>
            previous.lastCreated != current.lastCreated ||
            previous.failureMessage != current.failureMessage,
        listener: (context, state) {
          if (state.failureMessage != null) {
            AppUtils.showSnackBar(
              context,
              transactionErrorMessage(l10n, state.failureCode) ??
                  state.failureMessage!,
              isError: true,
            );
          } else if (state.lastCreated != null) {
            AppUtils.showSnackBar(context, l10n.transactionQueued);
          }
        },
        builder: (context, state) {
          if (state.status == TransactionsViewStatus.loading) {
            return const Center(child: CircularProgressIndicator());
          }
          if (state.transactions.isEmpty) {
            return Center(child: Text(l10n.transactionsEmpty));
          }
          return ListView.separated(
            // Room for the floating action button.
            padding: const EdgeInsets.only(bottom: 88),
            itemCount: state.transactions.length,
            separatorBuilder: (_, _) => const Divider(height: 1),
            itemBuilder: (_, index) =>
                TransactionTile(transaction: state.transactions[index]),
          );
        },
      ),
      floatingActionButton: FloatingActionButton.extended(
        onPressed: () => _create(context),
        icon: const Icon(Icons.add),
        label: Text(l10n.transactionsAdd),
      ),
    );
  }
}
