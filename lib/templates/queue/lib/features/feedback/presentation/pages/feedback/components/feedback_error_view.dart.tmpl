// ─────────────────────────────────────────────────────────────
// FeedbackErrorView
// Error state of the feedback page: message plus a retry button.
// ─────────────────────────────────────────────────────────────

import 'package:flutter/material.dart';
import 'package:{{package}}/core/l10n/l10n.dart';

/// Shows [message] and a button that calls [onRetry].
class FeedbackErrorView extends StatelessWidget {
  /// Creates the error view.
  const FeedbackErrorView({
    required this.message,
    required this.onRetry,
    super.key,
  });

  /// Error message to display.
  final String message;

  /// Called when the user taps Retry.
  final VoidCallback onRetry;

  @override
  Widget build(BuildContext context) {
    return Center(
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          const Icon(Icons.error_outline, color: Colors.red, size: 48),
          const SizedBox(height: 16),
          Text(
            message,
            textAlign: TextAlign.center,
            style: Theme.of(context).textTheme.bodyMedium,
          ),
          const SizedBox(height: 16),
          ElevatedButton(
            onPressed: onRetry,
            child: Text(context.l10n.feedbackRetry),
          ),
        ],
      ),
    );
  }
}
