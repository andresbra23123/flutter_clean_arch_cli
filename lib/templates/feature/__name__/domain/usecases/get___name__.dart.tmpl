/// Fetches the current [{{Name}}Entity] through the [{{Name}}RepositoryInter].
class Get{{Name}}UseCaseImpl implements UseCaseInter<{{Name}}Entity, NoParams> {
  /// Creates the use case with the [repository] it reads from.
  Get{{Name}}UseCaseImpl({required this.repository});

  /// Source of the {{nameWords}} data.
  final {{Name}}RepositoryInter repository;

  /// Returns the [{{Name}}Entity], or a [Failure] if it could not be obtained.
  @override
  FutureEither<{{Name}}Entity> call(NoParams params) async {
    final result = await repository.get{{Name}}();
