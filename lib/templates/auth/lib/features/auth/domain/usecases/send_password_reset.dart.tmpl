// ─────────────────────────────────────────────────────────────
// SendPasswordResetUseCase
// Sends the email to reset a forgotten password.
// ─────────────────────────────────────────────────────────────

import 'package:{{package}}/core/type_defs/type_defs.dart';
import 'package:{{package}}/core/usecases/usecases.dart';
import 'package:{{package}}/features/auth/domain/domain.dart';
import 'package:dartz/dartz.dart';

/// Sends a password reset link to the given email.
class SendPasswordResetUseCaseImpl implements UseCaseInter<Unit, String> {
  /// Creates the use case with the [repository] it uses.
  SendPasswordResetUseCaseImpl({required this.repository});

  /// Sends the email.
  final AuthRepositoryInter repository;

  /// Sends the link to [params], the email of the account.
  @override
  FutureEither<Unit> call(String params) {
    return repository.sendPasswordResetEmail(email: params);
  }
}
