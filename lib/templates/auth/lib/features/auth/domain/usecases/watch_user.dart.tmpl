// ─────────────────────────────────────────────────────────────
// WatchUserUseCase
// Streams the session state: the signed-in user or null.
// ─────────────────────────────────────────────────────────────

import 'package:{{package}}/core/type_defs/type_defs.dart';
import 'package:{{package}}/core/usecases/usecases.dart';
import 'package:{{package}}/features/auth/domain/domain.dart';

/// Streams the signed-in user (`null` when there is no session).
class WatchUserUseCaseImpl implements UseCaseInterStream<UserEntity?, NoParams> {
  /// Creates the use case with the [repository] it reads from.
  WatchUserUseCaseImpl({required this.repository});

  /// Source of the session state.
  final AuthRepositoryInter repository;

  /// Emits on every sign-in, sign-out and profile change. An error arrives
  /// as a `Failure` on the left side and the stream keeps going.
  @override
  StreamEither<UserEntity?> call(NoParams params) => repository.userChanges();
}
