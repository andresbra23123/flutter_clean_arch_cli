// ─────────────────────────────────────────────────────────────
// Auth dependency injection
// Registers every dependency of the auth feature and initializes
// Google Sign-In.
// Called from initDependencies() in core/di/injection_container.dart.
// ─────────────────────────────────────────────────────────────

import 'package:{{package}}/core/di/di.dart';
import 'package:{{package}}/features/auth/data/data.dart';
import 'package:{{package}}/features/auth/domain/domain.dart';
import 'package:{{package}}/features/auth/presentation/presentation.dart';
import 'package:firebase_auth/firebase_auth.dart';
import 'package:firebase_core/firebase_core.dart';
import 'package:flutter/foundation.dart';
import 'package:google_sign_in/google_sign_in.dart';

/// Registers the BLoCs, use cases, repository and data source of the auth
/// feature, and initializes Google Sign-In.
///
/// [firebaseOptions] are the options of the running flavor. On iOS their
/// `iosClientId` is the OAuth client Google Sign-In uses; on Android the
/// client comes from `google-services.json`.
///
/// Contracts are registered with their `Inter` type, so the
/// implementations can be swapped (e.g. for mocks in tests).
Future<void> initAuthDependencies({
  required FirebaseOptions firebaseOptions,
}) async {
  final googleSignIn = GoogleSignIn.instance;
  await googleSignIn.initialize(
    clientId: defaultTargetPlatform == TargetPlatform.iOS
        ? firebaseOptions.iosClientId
        : null,
  );

  getIt
    // ── External ────────────────────────────────────────────
    ..registerLazySingleton(() => FirebaseAuth.instance)
    ..registerLazySingleton(() => googleSignIn)
    // ── Presentation ────────────────────────────────────────
    // Lazy singleton: one session state shared by the whole app and the
    // router. It starts listening to Firebase as soon as it is created.

    // ── BLoCs ───────────────────────────────────────────────
    
    ..registerLazySingleton(
      () => AuthBloc(
        watchUser: getIt(),
        getCurrentUser: getIt(),
        signOut: getIt(),
      )..add(const AuthSubscriptionRequested()),
    )
    // Factories: a new BLoC every time a screen asks for one.
    ..registerFactory(
      () => LoginBloc(signInWithEmail: getIt(), signInWithGoogle: getIt()),
    )
    ..registerFactory(() => RegisterBloc(signUpWithEmail: getIt()))
    ..registerFactory(() => ForgotPasswordBloc(sendPasswordReset: getIt()))


    // ── Domain ──────────────────────────────────────────────

    // Lazy singletons: created once, the first time they are needed.
    ..registerLazySingleton(() => WatchUserUseCaseImpl(repository: getIt()))
    ..registerLazySingleton(
      () => GetCurrentUserUseCaseImpl(repository: getIt()),
    )
    ..registerLazySingleton(
      () => SignInWithEmailUseCaseImpl(repository: getIt()),
    )
    ..registerLazySingleton(
      () => SignUpWithEmailUseCaseImpl(repository: getIt()),
    )
    ..registerLazySingleton(
      () => SignInWithGoogleUseCaseImpl(repository: getIt()),
    )
    ..registerLazySingleton(
      () => SendPasswordResetUseCaseImpl(repository: getIt()),
    )
    ..registerLazySingleton(() => SignOutUseCaseImpl(repository: getIt()))


    // ── Data ───────────────────────────────────────────────

    ..registerLazySingleton<AuthRepositoryInter>(
      () => AuthRepositoryImpl(remoteDataSource: getIt(), networkInfo: getIt()),
    )
    ..registerLazySingleton<AuthRemoteDataSourceInter>(
      () => AuthRemoteDataSourceImpl(
        firebaseAuth: getIt(),
        googleSignIn: getIt(),
      ),
    );
}
