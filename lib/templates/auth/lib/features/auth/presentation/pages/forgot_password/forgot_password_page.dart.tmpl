// ─────────────────────────────────────────────────────────────
// ForgotPasswordPage
// Asks for the email and sends the password reset link.
// After sending, it shows a confirmation instead of the form.
// ─────────────────────────────────────────────────────────────

import 'package:{{package}}/core/di/di.dart';
import 'package:{{package}}/core/l10n/l10n.dart';
import 'package:{{package}}/core/mixings/mixings.dart';
import 'package:{{package}}/core/router/router.dart';
import 'package:{{package}}/features/auth/presentation/presentation.dart';
import 'package:flutter/material.dart';
import 'package:flutter_bloc/flutter_bloc.dart';
import 'package:go_router/go_router.dart';

/// Entry point of the forgot password screen. Provides the
/// [ForgotPasswordBloc].
class ForgotPasswordPage extends StatelessWidget {
  /// Creates the forgot password page.
  const ForgotPasswordPage({super.key});

  @override
  Widget build(BuildContext context) {
    return BlocProvider(
      create: (_) => getIt<ForgotPasswordBloc>(),
      child: const ForgotPasswordView(),
    );
  }
}

/// UI of the forgot password screen. Reads the [ForgotPasswordBloc]
/// provided by [ForgotPasswordPage].
class ForgotPasswordView extends StatefulWidget {
  /// Creates the forgot password view.
  const ForgotPasswordView({super.key});

  @override
  State<ForgotPasswordView> createState() => _ForgotPasswordViewState();
}

class _ForgotPasswordViewState extends State<ForgotPasswordView>
    with Validator {
  final _formKey = GlobalKey<FormState>();
  final _emailController = TextEditingController();

  @override
  void dispose() {
    _emailController.dispose();
    super.dispose();
  }

  void _submit() {
    if (!_formKey.currentState!.validate()) return;
    context.read<ForgotPasswordBloc>().add(
      ForgotPasswordSubmitted(email: _emailController.text.trim()),
    );
  }

  @override
  Widget build(BuildContext context) {
    final l10n = context.l10n;

    return BlocConsumer<ForgotPasswordBloc, ForgotPasswordState>(
      listener: (context, state) {
        if (state is! ForgotPasswordFailure) return;
        ScaffoldMessenger.of(context)
          ..hideCurrentSnackBar()
          ..showSnackBar(
            SnackBar(content: Text(authErrorMessage(l10n, state.errorCode))),
          );
      },
      builder: (context, state) {
        if (state is ForgotPasswordSuccess) {
          return AuthScaffold(
            title: l10n.forgotPasswordTitle,
            showAppBar: true,
            children: [
              const Icon(Icons.mark_email_read_outlined, size: 64),
              const SizedBox(height: 16),
              Text(
                l10n.forgotPasswordSuccess(_emailController.text.trim()),
                textAlign: TextAlign.center,
              ),
              const SizedBox(height: 32),
              FilledButton(
                onPressed: () => context.goNamed(AppRoutes.loginName),
                style: FilledButton.styleFrom(
                  minimumSize: const Size.fromHeight(48),
                ),
                child: Text(l10n.backToLogin),
              ),
            ],
          );
        }

        return AuthScaffold(
          title: l10n.forgotPasswordTitle,
          subtitle: l10n.forgotPasswordDescription,
          showAppBar: true,
          children: [
            Form(
              key: _formKey,
              child: AuthTextField(
                controller: _emailController,
                label: l10n.emailLabel,
                icon: Icons.email_outlined,
                keyboardType: TextInputType.emailAddress,
                textInputAction: TextInputAction.done,
                autofillHints: const [AutofillHints.email],
                enabled: state is! ForgotPasswordLoading,
                validator: (value) => validateEmail(l10n, value),
                onSubmitted: (_) => _submit(),
              ),
            ),
            const SizedBox(height: 24),
            AuthSubmitButton(
              label: l10n.forgotPasswordButton,
              isLoading: state is ForgotPasswordLoading,
              onPressed: _submit,
            ),
          ],
        );
      },
    );
  }
}
