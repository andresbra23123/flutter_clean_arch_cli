// ─────────────────────────────────────────────────────────────
// ForgotPasswordEvent
// Every event that ForgotPasswordBloc can receive.
// ─────────────────────────────────────────────────────────────

part of 'forgot_password_bloc.dart';

/// Base class for all forgot password events.
abstract class ForgotPasswordEvent extends Equatable {
  /// Base constructor for the subclasses.
  const ForgotPasswordEvent();

  @override
  List<Object?> get props => [];
}

/// The user asked for the reset email.
class ForgotPasswordSubmitted extends ForgotPasswordEvent {
  /// Creates the event with the [email] of the account.
  const ForgotPasswordSubmitted({required this.email});

  /// Email of the account to reset.
  final String email;

  @override
  List<Object?> get props => [email];
}
