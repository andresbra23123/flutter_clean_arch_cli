// ─────────────────────────────────────────────────────────────
// ForgotPasswordBloc
// Handles the "forgot password" form: sends the reset email.
// ─────────────────────────────────────────────────────────────

import 'package:{{package}}/features/auth/domain/domain.dart';
import 'package:{{package}}/features/auth/presentation/presentation.dart';
import 'package:equatable/equatable.dart';
import 'package:flutter_bloc/flutter_bloc.dart';

part 'forgot_password_event.dart';
part 'forgot_password_state.dart';

/// Manages the state of the forgot password screen.
///
/// Created by get_it as a factory, so every screen gets its own instance.
class ForgotPasswordBloc
    extends Bloc<ForgotPasswordEvent, ForgotPasswordState> {
  /// Creates the BLoC in the [ForgotPasswordInitial] state.
  ForgotPasswordBloc({required this._sendPasswordReset})
    : super(const ForgotPasswordInitial()) {
    on<ForgotPasswordSubmitted>(_onSubmitted);
  }

  final SendPasswordResetUseCaseImpl _sendPasswordReset;

  /// Handles [ForgotPasswordSubmitted]: emits [ForgotPasswordLoading], then
  /// [ForgotPasswordSuccess] or [ForgotPasswordFailure].
  Future<void> _onSubmitted(
    ForgotPasswordSubmitted event,
    Emitter<ForgotPasswordState> emit,
  ) async {
    emit(const ForgotPasswordLoading());
    final result = await _sendPasswordReset(event.email);
    result.fold(
      (failure) =>
          emit(ForgotPasswordFailure(errorCode: authErrorCode(failure))),
      (_) => emit(const ForgotPasswordSuccess()),
    );
  }
}
