// ─────────────────────────────────────────────────────────────
// ForgotPasswordState
// Every state that ForgotPasswordBloc can emit.
// ─────────────────────────────────────────────────────────────

part of 'forgot_password_bloc.dart';

/// Base class for all forgot password states.
abstract class ForgotPasswordState extends Equatable {
  /// Base constructor for the subclasses.
  const ForgotPasswordState();

  @override
  List<Object?> get props => [];
}

/// Nothing submitted yet.
class ForgotPasswordInitial extends ForgotPasswordState {
  /// Creates the initial state.
  const ForgotPasswordInitial();
}

/// Sending the email. The form is disabled.
class ForgotPasswordLoading extends ForgotPasswordState {
  /// Creates the loading state.
  const ForgotPasswordLoading();
}

/// The reset email was sent. The page shows a confirmation.
class ForgotPasswordSuccess extends ForgotPasswordState {
  /// Creates the success state.
  const ForgotPasswordSuccess();
}

/// The email could not be sent.
class ForgotPasswordFailure extends ForgotPasswordState {
  /// Creates the failure state with the [errorCode] of the error.
  const ForgotPasswordFailure({this.errorCode});

  /// Code from `AuthErrorCodes`, or `null` for an unknown error.
  final String? errorCode;

  @override
  List<Object?> get props => [errorCode];

  @override
  String toString() => 'ForgotPasswordFailure(errorCode: $errorCode)';
}
